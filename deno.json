{
  "name": "@notesnook-deno/workspace",
  "version": "2.2.0",
  "license": "GPL-3.0-or-later",
  "nodeModulesDir": "auto",
  "unstable": [
    "sloppy-imports"
  ],
  "workspace": [
    "./apps/desktop",
    "./packages/sync-webdav",
    "./packages/sync-core",
    "./packages/sync-files",
    "./packages/sync-sql",
    "./packages/acp"
  ],
  "imports": {
    "@notesnook/crypto": "./packages/crypto/src/index.ts",
    "@notesnook/sodium": "./packages/sodium/src/browser.ts",
    "@notesnook/acp": "./packages/acp/src/index.ts",
    "@notesnook/sync-core": "./packages/sync-core/src/index.ts",
    "@notesnook/sync-files": "./packages/sync-files/src/index.ts",
    "@notesnook/sync-webdav": "./packages/sync-webdav/src/index.ts",
    "@notesnook/sync-sql": "./packages/sync-sql/src/index.ts",
    "@notesnook/sync-sql/postgres": "./packages/sync-sql/src/postgres.ts",
    "postgres": "npm:postgres@^3.4.9",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.9",
    "@std/encoding": "jsr:@std/encoding@^1.0.7",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "libsodium-wrappers-sumo": "./packages/sodium/src/libsodium.ts",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@std/cli": "jsr:@std/cli@^1.0.9"
  },
  "tasks": {
    "dev": "deno run -A apps/desktop/scripts/dev.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check apps/desktop/main.ts packages/sync-webdav/src/index.ts packages/sync-core/src/index.ts packages/sync-files/src/index.ts packages/sync-sql/src/index.ts packages/sync-sql/src/postgres.ts packages/acp/src/index.ts",
    "test": "deno test -A packages/sync-webdav/tests/ packages/sync-core/tests/ packages/sync-files/tests/ packages/sync-sql/tests/ packages/acp/tests/ packages/theme/tests/ apps/desktop/tests/ --ignore=packages/sync-webdav/tests/integration",
    "test:sql": "deno run -A packages/sync-sql/tests/run-integration.ts",
    "test:webdav": "deno run -A packages/sync-webdav/tests/run-integration.ts",
    "test:ui": "deno run -A --node-modules-dir=auto npm:vitest@3.2.4 run --root apps/web",
    "bench": "deno run -A apps/desktop/scripts/benchmark.ts",
    "build:ui": "deno run -A apps/desktop/scripts/build-ui.ts",
    "build": "deno run -A apps/desktop/scripts/build.ts",
    "build:windows": "deno run -A apps/desktop/scripts/build.ts --target x86_64-pc-windows-msvc",
    "build:linux": "deno run -A apps/desktop/scripts/build.ts --target x86_64-unknown-linux-gnu",
    "build:appimage": "deno run -A apps/desktop/scripts/build.ts --target x86_64-unknown-linux-gnu --format appimage",
    "build:deb": "deno run -A apps/desktop/scripts/build.ts --target x86_64-unknown-linux-gnu --format deb",
    "build:rpm": "deno run -A apps/desktop/scripts/build.ts --target x86_64-unknown-linux-gnu --format rpm",
    "build:msi": "deno run -A apps/desktop/scripts/build.ts --target x86_64-pc-windows-msvc --format msi",
    "build:tar": "deno run -A apps/desktop/scripts/build.ts --target x86_64-unknown-linux-gnu --format tar.gz",
    "build:exe": "deno run -A apps/desktop/scripts/build.ts --target x86_64-pc-windows-msvc --format exe",
    "build:zip": "deno run -A apps/desktop/scripts/build.ts --target x86_64-pc-windows-msvc --format zip",
    "build:all": "deno run -A apps/desktop/scripts/build.ts --all",
    "smoke": "deno run -A apps/desktop/scripts/smoke-test.ts",
    "check:mcp": "deno run -A apps/desktop/scripts/mcp-check.ts",
    "check:acp": "deno run -A apps/desktop/scripts/acp-check.ts",
    "checksums": "deno run -A apps/desktop/scripts/checksums.ts",
    "checksums:check": "deno run -A apps/desktop/scripts/checksums.ts dist --check",
    "verify:no-electron": "deno run -A apps/desktop/scripts/verify-dependencies.ts",
    "build:native": "deno run -A apps/desktop/scripts/build-native.ts",
    "check:native": "deno run -A apps/desktop/scripts/build-native.ts --check",
    "test:sync": "deno test -A packages/sync-webdav/tests/client_test.ts packages/sync-webdav/tests/sync_test.ts packages/sync-webdav/tests/backup_test.ts packages/sync-core/tests/",
    "test:desktop": "deno test -A apps/desktop/tests/"
  },
  "fmt": {
    "include": [
      "apps/desktop/main.ts",
      "apps/desktop/src",
      "apps/desktop/scripts",
      "apps/desktop/types",
      "packages/sync-webdav/src",
      "packages/sync-webdav/tests",
      "packages/sync-core/src",
      "packages/sync-core/tests",
      "packages/sync-files/src",
      "packages/sync-files/tests",
      "packages/sync-sql/src",
      "packages/sync-sql/tests",
      "packages/acp/src",
      "packages/acp/tests",
      "packages/theme/tests"
    ],
    "exclude": [
      "apps/web/src/common/sqlite/*.js",
      "apps/web/build",
      "apps/desktop/ui",
      "**/node_modules",
      "**/dist",
      "**/build"
    ]
  },
  "lint": {
    "include": [
      "apps/desktop/main.ts",
      "apps/desktop/src",
      "apps/desktop/scripts",
      "packages/sync-webdav/src",
      "packages/sync-webdav/tests",
      "packages/sync-core/src",
      "packages/sync-core/tests",
      "packages/sync-files/src",
      "packages/sync-files/tests",
      "packages/sync-sql/src",
      "packages/sync-sql/tests",
      "packages/acp/src",
      "packages/acp/tests",
      "packages/theme/tests"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true
  },
  "exclude": [
    "apps/web/build",
    "apps/web/node_modules",
    "node_modules",
    "**/dist"
  ],
  "permissions": {
    "app": {
      "env": [
        "DENO_SERVE_ADDRESS",
        "OPENOTES_DATA_DIR",
        "OPENOTES_UI_ROOT",
        "OPENOTES_NATIVE_DIR",
        "OPENOTES_LOG_LEVEL",
        "OPENOTES_DEV",
        "OPENOTES_PORTABLE",
        "OPENOTES_UI_PORT",
        "OPENOTES_SQLITE3MC_SHA256",
        "DENO_SQLITE_PATH",
        "HOME",
        "USERPROFILE",
        "APPDATA",
        "TMPDIR",
        "TEMP",
        "TMP",
        "XDG_DATA_HOME",
        "XDG_CONFIG_HOME",
        "XDG_CACHE_HOME",
        "XDG_DOCUMENTS_DIR",
        "GTK_THEME",
        "APPIMAGE",
        "FLATPAK_ID",
        "SNAP",
        "CI",
        "DENO_SQLITE_LOCAL",
        "DENO_DIR",
        // Finding an ACP agent means looking for its binary, and this list
        // is exhaustive: reading an unlisted variable does not return
        // undefined, it throws NotCapable. Leaving PATH out of it is what
        // made the AI assistant fail in every packaged build from 2.0.0 to
        // 2.1.2 while working under `deno task dev`, which runs with -A.
        // PATHEXT is the Windows half of the same lookup.
        "PATH",
        "PATHEXT"
      ],
      "run": [
        "xdg-open",
        "open",
        "explorer",
        "cmd",
        "notify-send",
        "osascript",
        "zenity",
        "kdialog",
        "wl-copy",
        "wl-paste",
        "xclip",
        "dbus-send",
        // How each desktop reports its light/dark preference. These are read
        // by detectSystemTheme(); without them every probe fails silently and
        // the app reports "light" on a dark desktop.
        "gsettings",
        "kreadconfig5",
        "defaults",
        "reg",
        "node",
        "npx",
        "deno",
        "bun",
        // Two different adapters put Claude Code on ACP, and they install
        // different binaries: @agentclientprotocol/claude-agent-acp provides
        // claude-agent-acp, @zed-industries/claude-code-acp provides
        // claude-code-acp. Allowing only the second meant the adapter the
        // settings screen tells people to install could not be launched.
        "claude-agent-acp",
        "claude-code-acp",
        "gemini",
        "opencode",
        // Codex has no ACP mode of its own; the adapter is a separate binary.
        "codex-acp",
        // Antigravity's command-line agent. `antigravity` is the editor.
        "agy"
      ],
      "read": true,
      "write": true,
      "net": true,
      "ffi": true,
      "sys": [
        "hostname",
        "osRelease",
        "uid"
      ],
      "import": false
    }
  },
  "exports": {
    ".": "./apps/desktop/main.ts"
  }
}

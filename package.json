{
  "name": "openotes",
  "private": true,
  "description": "Node build toolchain for the Openotes web UI bundle. The application itself is built and run with Deno (see deno.json).",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "npm run tx -- build --all --exclude=web",
    "build:web": "npm run tx web:build",
    "build:desktop:web": "npm run tx web:build:desktop",
    "build:test:web": "npm run tx web:build:test",
    "build:help": "npm run tx help:build",
    "start:web": "npm run tx web:start",
    "start:editor": "npm run tx editor:start",
    "build:intl": "npm run tx intl:build",
    "start:intl": "npm run tx intl:start",
    "test:web": "npm run tx web:test",
    "test:core": "npm run tx core:test",
    "tx": "node scripts/execute.mjs"
  },
  "devDependencies": {
    "@types/node": "^18.7.13",
    "@typescript/native-preview": "^7.0.0-dev.20251006.1",
    "cross-env": "^7.0.3",
    "serve": "^14.0.1",
    "tsdown": "^0.15.6"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "fdir": "^6.5.0",
    "listr2": "^8.2.3",
    "patch-package": "^7.0.0",
    "typescript": "^5.6.3",
    "yargs-parser": "^21.1.1"
  },
  "license": "GPL-3.0-or-later",
  "volta": {
    "node": "22.20.0"
  },
  "taskRunner": {
    "projects": [
      "packages/*",
      "apps/*",
      "docs/*"
    ],
    "tasks": [
      {
        "dependencies": [
          "build"
        ],
        "commands": [
          "start",
          "build",
          "build:test",
          "build:desktop",
          "build:test:desktop",
          "start:desktop",
          "test",
          "test:e2e"
        ]
      }
    ]
  }
}
